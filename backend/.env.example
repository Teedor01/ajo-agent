# Copy this file to .env and fill in real values. .env is already in
# .gitignore -- never commit your actual keys.

# --- Model backend: set the Bedrock block below for your real submission. ---
# Requires: Bedrock model access enabled in the AWS console (Bedrock -> Model
# access), plus standard AWS credentials. The hackathon gives participants
# $50 in AWS credits -- apply those to this account before spending your own.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Optional fallback: only needed if you ever want to test locally against
# Claude directly instead of Bedrock. Anthropic API usage is paid per token --
# skip this entirely if BEDROCK_MODEL_ID above is set; the agent never looks
# at this variable when a Bedrock model ID is present. ---
# ANTHROPIC_API_KEY=

# --- Database. Leave unset to use local SQLite (recommended for the demo --
# zero external setup). Only set this if you've stood up your own Postgres. ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname
